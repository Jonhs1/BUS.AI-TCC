# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O ".env" não vai para o Git: ele guarda a senha do banco e a chave dos tokens.

# Conexão com o PostgreSQL: postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:SUA-SENHA@localhost:5432/busai"

# Chave usada para assinar os tokens de login (JWT). Use um texto longo e aleatório.
# Quem souber esta chave consegue criar tokens válidos: nunca compartilhe.
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Página coletora dos testes de campo (public/coletor.html): "true" para ligar, "false" para desligar
HABILITAR_COLETOR="false"
